rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a verified teacher
    // Verified teachers are provisioned in the /teachers/{uid} collection via Firebase Console
    function isTeacher() {
      return isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // User profiles
    match /users/{userId} {
      // Students can read their own profile; verified teachers can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isTeacher());
      
      // Public registration: strictly allows creating user document with role == 'student'
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    request.resource.data.role == 'student';
      
      // Users can update their own profile fields (cannot change their role to teacher); teachers have full update
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) ||
        isTeacher()
      );
      
      allow delete: if isTeacher();
    }

    // Verified teachers directory
    match /teachers/{teacherId} {
      // Authenticated users can read to verify teacher permissions
      allow read: if isAuthenticated();
      // Teacher authorization documents are managed directly via Firebase Console
      allow write: if false;
    }

    // Experiment submissions
    match /submissions/{submissionId} {
      // Students can only read their own submissions; teachers can read all
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        isTeacher()
      );

      // Students can create their own experiment submission with matching studentId
      allow create: if isAuthenticated() && 
                    request.resource.data.studentId == request.auth.uid;

      // Submissions are immutable laboratory records (cannot be edited or deleted by students)
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Fallback: deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
